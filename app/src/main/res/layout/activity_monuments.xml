<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MonumentsActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/background"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvTitleMonuments"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            android:text="@string/monuments"
            android:textAlignment="center"
            android:textColor="#E91E63"
            android:textSize="24sp" />

        <View
            android:id="@+id/divider2"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginBottom="10dp"
            android:background="@color/purple_500" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivIglesia"
                android:layout_width="200dp"
                android:layout_height="140dp"
                android:layout_marginRight="5dp"
                android:layout_weight="1"
                android:contentDescription="@string/x_church_san_lucas"
                app:srcCompat="@drawable/x_iglesia_san_juan_arucas" />

            <TextView
                android:id="@+id/tvIglesia"
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:text="@string/xi_church_san_lucas"
                android:textAlignment="center"
                android:textColor="#000000"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="9dp">

            <ImageView
                android:id="@+id/ivFaro"
                android:layout_width="200dp"
                android:layout_height="140dp"
                android:layout_marginRight="5dp"
                android:contentDescription="@string/x_lighthouse_maspalomas"
                app:srcCompat="@drawable/x_faro_maspalomas" />

            <TextView
                android:id="@+id/tvFaro"
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:text="@string/xi_lighthouse_maspalomas"
                android:textAlignment="center"
                android:textColor="#000000"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="9dp">

            <ImageView
                android:id="@+id/ivBasilica"
                android:layout_width="200dp"
                android:layout_height="140dp"
                android:layout_marginRight="5dp"
                android:layout_weight="1"
                android:contentDescription="@string/x_basilica_del_pino"
                app:srcCompat="@drawable/x_basilica_del_pino" />

            <TextView
                android:id="@+id/tvBasilica"
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:text="@string/xi_basilica_del_pino"
                android:textAlignment="center"
                android:textColor="#000000"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="9dp">

            <ImageView
                android:id="@+id/ivCastillo"
                android:layout_width="200dp"
                android:layout_height="140dp"
                android:layout_marginRight="5dp"
                android:contentDescription="@string/x_castle_of_light"
                app:srcCompat="@drawable/x_castillo_de_la_luz" />

            <TextView
                android:id="@+id/tvCastillo"
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:text="@string/xi_castle_of_light"
                android:textAlignment="center"
                android:textColor="#000000"
                android:textSize="10sp" />

        </LinearLayout>

        <Button
            android:id="@+id/btVolverX"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/volver" />

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
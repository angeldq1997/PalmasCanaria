<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MuseumsActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/background"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvTitleMuseums"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            android:text="@string/museums"
            android:textAlignment="center"
            android:textColor="#04570A"
            android:textSize="24sp" />

        <View
            android:id="@+id/divider2"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginBottom="10dp"
            android:background="@color/purple_500" />

        <TextView
            android:id="@+id/tvTCasaColon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/m_house_colon"
            android:textAlignment="center"
            android:textColor="#04570A"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivCasaColon"
                android:layout_width="200dp"
                android:layout_height="150dp"
                android:layout_marginRight="5dp"
                android:contentDescription="@string/m_house_colon"
                app:srcCompat="@drawable/m_casa_colon" />

            <TextView
                android:id="@+id/tvCasaColon"
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:text="@string/mi_casa_colon"
                android:textAlignment="center"
                android:textColor="#04570A"
                android:textSize="10sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvTMuseoCanario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/m_house_colon"
            android:textAlignment="center"
            android:textColor="#04570A"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="9dp">

            <ImageView
                android:id="@+id/ivMuseoCanario"
                android:layout_width="200dp"
                android:layout_height="150dp"
                android:layout_marginRight="5dp"
                android:contentDescription="@string/m_museum_canario"
                app:srcCompat="@drawable/m_museo_canario" />

            <TextView
                android:id="@+id/tvMuseoCanario"
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:text="@string/mi_museum_canario"
                android:textAlignment="center"
                android:textColor="#04570A"
                android:textSize="10sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvTMuseoElder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/m_house_colon"
            android:textAlignment="center"
            android:textColor="#04570A"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="9dp">

            <ImageView
                android:id="@+id/ivMuseoElder"
                android:layout_width="200dp"
                android:layout_height="140dp"
                android:layout_marginRight="5dp"
                android:contentDescription="@string/m_museum_elder"
                app:srcCompat="@drawable/m_museo_elder" />

            <TextView
                android:id="@+id/tvMuseoElder"
                android:layout_width="180dp"
                android:layout_height="wrap_content"
                android:text="@string/mi_museum_elder"
                android:textAlignment="center"
                android:textColor="#04570A"
                android:textSize="10sp" />

        </LinearLayout>

        <Button
            android:id="@+id/btVolverM"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/volver" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>